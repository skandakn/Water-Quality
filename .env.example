# Jaal Drushti - Environment Variables

# Application
APP_ENV=development
APP_NAME="Jaal Drushti - AI-Powered Lake Water Intelligence"
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
FRONTEND_URL=http://localhost:5173

# Database
# If DATABASE_URL is not set or PostgreSQL is unavailable, SQLite fallback (jaal_drushti.db) is automatically used.
DATABASE_URL=sqlite:///./jaal_drushti.db
# For PostgreSQL:
# DATABASE_URL=postgresql://jaal_user:jaal_password@localhost:5432/jaal_drushti_db

# Security
SECRET_KEY=super-secret-jaal-drushti-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Mode
DEMO_MODE=true

# Telegram alert delivery (server-side only; never expose the bot token in frontend code)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10

# Prithvi / Pruthvi EO V2 water extent model
# Run the heavy model as a separate FastAPI service, then point this app to it.
# Example local model service URL: http://127.0.0.1:8001
PRITHVI_API_BASE_URL=
PRITHVI_MODEL_ROOT=C:\Users\skand\Documents\Pruthvi-model
PRITHVI_REQUEST_TIMEOUT_SECONDS=300
